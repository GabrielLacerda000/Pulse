includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        -
            message: '#Call to an undefined method Faker\\Generator::stateAbbr\(\)#'
            path: database/factories/LeadFactory.php
